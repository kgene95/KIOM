; Short restrained NPT equilibration template. Review with selected force field before use.
define                   = -DPOSRES
integrator               = md
dt                       = 0.002
nsteps                   = 50000
nstxout-compressed       = 500
nstenergy                = 500
nstlog                   = 500
continuation             = yes
constraint-algorithm     = lincs
constraints              = h-bonds
lincs-order              = 4
cutoff-scheme            = Verlet
nstlist                  = 20
coulombtype              = PME
rcoulomb                 = 1.2
vdwtype                  = Cut-off
vdw-modifier             = Force-switch
rvdw-switch              = 1.0
rvdw                     = 1.2
tcoupl                   = V-rescale
tc-grps                  = Protein_Ligand Water_and_ions
tau-t                    = 0.1 0.1
tc-ref                   = 300 300
pcoupl                   = C-rescale
pcoupltype               = isotropic
tau-p                    = 2.0
ref-p                    = 1.0
compressibility          = 4.5e-5
pbc                      = xyz
gen-vel                  = no
