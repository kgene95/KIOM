; Force-field-agnostic energy-minimization template. Use only after a validated topology exists.
integrator               = steep
emtol                    = 1000.0
emstep                   = 0.01
nsteps                   = 50000
cutoff-scheme            = Verlet
nstlist                  = 20
vdwtype                  = Cut-off
vdw-modifier             = Force-switch
rvdw-switch              = 1.0
rvdw                     = 1.2
coulombtype              = PME
rcoulomb                 = 1.2
pbc                      = xyz
